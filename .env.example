DATABASE_URL=postgresql://ipdr_user:CHANGE_ME@localhost:5432/ipdr_db
CORS_ORIGINS=*

# sFlow: multiply sampled bytes/packets by sampling_rate to approximate ~100% volume
SFLOW_EXTRAPOLATE=true

# Auth (set IPDR_AUTH_REQUIRED=true in production)
# Format: role:secret[,role:secret...]  roles: collector, ops, lea, admin
IPDR_AUTH_REQUIRED=false
IPDR_API_KEYS=admin:change-me-admin,lea:change-me-lea,ops:change-me-ops,collector:change-me-collector

# Retention (days). Rows with legal_hold=true are never purged.
IPDR_RETENTION_DAYS=365
CGNAT_RETENTION_DAYS=365
AAA_RETENTION_DAYS=365

# Durable ingest (HSL / NetFlow → DB). Spool used if DB or queue backs up.
IPDR_SPOOL_DIR=data/ingest_spool
IPDR_INGEST_QUEUE_MAX=50000
IPDR_CGNAT_DEDUP_TTL_SEC=3600
IPDR_TEMPLATE_STORE=data/netflow_templates.json
IPDR_TEMPLATE_PENDING_MAX=200
IPDR_TEMPLATE_PENDING_TTL_SEC=120

# Standalone HSL bridge: python -m app.bridges.cgnat_hsl_bridge
HSL_LISTEN_HOST=0.0.0.0
HSL_LISTEN_PORT=2055
